# ═══════════════════════════════════════════════════════════════════════
#  VARIÁVEIS DE AMBIENTE — igreja-app-backend
#
#  Copie para `.env` e preencha. O `.env` está no .gitignore e nunca deve
#  ser commitado; ESTE arquivo é o contrário — ele só tem os NOMES e valores
#  de exemplo, e por isso vai para o repositório.
#
#  O servidor valida tudo isto no boot (`src/config/env.ts`). Faltando uma
#  obrigatória, ele NÃO SOBE e diz qual é.
# ═══════════════════════════════════════════════════════════════════════


# ── OBRIGATÓRIAS ───────────────────────────────────────────────────────

# Conexão com o PostgreSQL.
DATABASE_URL="postgresql://usuario:senha@localhost:5432/igreja?schema=public"

# Segredo que assina os tokens de sessão.
#
# MÍNIMO DE 32 CARACTERES — o servidor recusa segredos curtos, porque um
# segredo fraco permite forjar token de qualquer pessoa, inclusive do
# administrador.
#
# Gere um assim:  node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
#
# ⚠️  Trocar este valor derruba TODAS as sessões ativas — todo mundo precisa
# entrar de novo. Use um valor diferente em produção e nunca o compartilhe.
JWT_SECRET="troque-por-um-valor-aleatorio-de-no-minimo-32-caracteres"

# Chave da Resend, usada no e-mail de recuperação de senha.
# Painel: https://resend.com/api-keys
RESEND_API_KEY="re_xxxxxxxxxxxxxxxxxxxx"


# ── OPCIONAIS (têm padrão) ─────────────────────────────────────────────

PORT="3000"

# development | production | test
NODE_ENV="development"

# Remetente dos e-mails, no formato: Nome <endereco@dominio>
#
# ⚠️  O padrão usa `onboarding@resend.dev`, que é o MODO DE TESTE do Resend:
# ele só entrega para o e-mail dono da conta. Em produção a congregação não
# receberia nada. Verifique um domínio no Resend antes de publicar.
EMAIL_REMETENTE="IBVI <nao-responda@suaigreja.com.br>"

# Origens liberadas no CORS, separadas por vírgula.
# Vazio = usa os padrões de desenvolvimento (localhost).
ALLOWED_ORIGINS="https://suaigreja.com.br"

# Tamanho máximo do corpo das requisições.
PAYLOAD_SIZE="100kb"

# Endereço de um painel WEB, se um dia existir. Hoje não é usado por nada:
# o e-mail de recuperação manda o CÓDIGO, não um link.
FRONTEND_URL=""


# ── CLOUDINARY (opcional) ──────────────────────────────────────────────
#
# Sem estas três o servidor sobe normalmente e apenas o upload de imagem
# responde 503, com mensagem clara. É de propósito: ninguém precisa
# configurar Cloudinary para rodar o projeto localmente.
#
# Painel: https://console.cloudinary.com
CLOUDINARY_CLOUD_NAME=""
CLOUDINARY_API_KEY=""
CLOUDINARY_API_SECRET=""
