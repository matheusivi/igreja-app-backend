generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model Usuario {
  id                Int      @id @default(autoincrement())
  nomeCompleto      String
  email             String   @unique
  senha             String
  perfil            String   @default("Membro") // Membro, Líder, Pastor, Administrador
  dataNascimento    DateTime?
  exibirAniversario Boolean  @default(true)
  batizado Boolean @default(false)
  estadoCivil       String?
  fotoUrl           String?  
  /// "Masculino" ou "Feminino". Obrigatório no cadastro.
  ///
  /// Virou opcional na coluna só por causa da exclusão de conta: sexo é dado
  /// pessoal e precisa ser destruído junto com o resto. A validação do
  /// cadastro continua exigindo — quem se cadastra informa; quem sai, apaga.
  sexo              String?
  profissao         String?

  /// Quando a senha foi trocada pela última vez.
  ///
  /// Existe para DERRUBAR SESSÕES. Trocar a senha invalidava só o token de
  /// recuperação — os JWT já emitidos continuavam valendo por até 24h. Quem
  /// tivesse o celular da pessoa em mãos seguia dentro do app um dia inteiro
  /// depois de ela ter trocado a senha justamente para expulsá-lo.
  ///
  /// O middleware compara este instante com o `iat` do token e recusa
  /// qualquer um emitido antes. Nulo significa "nunca trocou", e aí não há o
  /// que comparar — é o estado de todas as contas já existentes.
  senhaAlteradaEm   DateTime?

  /// Quando a pessoa pediu a exclusão da própria conta.
  ///
  /// ═══ POR QUE A LINHA NÃO É APAGADA ═══
  /// Avisos, cursos, eventos e grupos familiares guardam quem os criou, e o
  /// banco recusa apagar um usuário que tenha qualquer um deles. Apagar de
  /// verdade significaria levar junto o conteúdo da igreja — os avisos de um
  /// líder sumiriam com ele.
  ///
  /// A saída é anonimizar: todo dado pessoal é destruído e todo registro
  /// pessoal é apagado; sobra uma casca sem informação nenhuma, só para as
  /// chaves estrangeiras do conteúdo institucional continuarem válidas.
  ///
  /// É irreversível. Não existe caminho de volta no código, de propósito —
  /// "desativar e poder voltar" não conta como exclusão para Google nem Apple.
  ///
  /// ⚠️  Esta escolha PRECISA estar escrita na política de privacidade.
  contaRemovidaEm   DateTime?

  denunciasFeitas     Denuncia[] @relation("DenunciasFeitas")
  bloqueiosFeitos     Bloqueio[] @relation("BloqueiosFeitos")
  bloqueiosRecebidos  Bloqueio[] @relation("BloqueiosRecebidos")

  // ── Divulgação de trabalho na comunidade ─────────────────────────────
  // `divulgarTrabalho` é opt-in explícito, e não derivado de ter profissão
  // preenchida: a profissão foi informada para o cadastro de membro, não
  // para virar anúncio. Publicar telefone para a igreja inteira é uma
  // finalidade nova, e finalidade nova pede consentimento próprio — mesma
  // lógica do `exibirAniversario`, que já existe logo acima.
  telefone          String?
  especializacao    String?
  divulgarTrabalho  Boolean  @default(false)

  conteudos         Conteudo[]
  cursosCriados      Curso[]        @relation("CriadorCurso")
  historicoCursos    UsuarioCurso[]
  participacoesSalas UsuarioSala[]
  salasLideradas     SalaCurso[]    @relation("LiderSala")
  pedidosOracao     PedidoOracao[]
  leiturasDoPlano   LeituraPlano[]
  gruposFamiliares  MembroFamilia[] @relation("MembroDoGrupo")
  convitesEnviados  MembroFamilia[] @relation("ConvitesEnviados")
  gruposCriados     GrupoFamiliar[]  @relation("CriadorGrupo")
  eventosCriados     Evento[]  @relation("EventosCriados")
  passwordResetTokens PasswordResetToken[]

  @@map("usuarios")
}

model Conteudo {
  id             Int       @id @default(autoincrement())
  usuarioId      Int
  tipo           String    // Estudo, Devocional, Aviso, Material, Apresentacao
  titulo         String
  /// Sequência do post: parágrafos, imagens e vídeos na ordem em que foram
  /// escritos. É a fonte da verdade do conteúdo.
  ///
  /// Formato: [{ "tipo": "texto" | "imagem" | "video", "valor": "..." }]
  ///
  /// Guardado como Json e não numa tabela à parte porque os blocos nunca são
  /// consultados sozinhos — sempre vêm junto com o conteúdo — e a ordem já
  /// está no próprio array.
  blocos         Json?
  /// Os três campos abaixo são DERIVADOS dos blocos a cada gravação, e não
  /// editados diretamente. Existem para que listagens e buscas continuem
  /// simples: `texto` alimenta o resumo e a busca, `imagemUrl` é a capa que
  /// aparece nos cards, `videoUrl` é o primeiro vídeo.
  texto          String?
  imagemUrl      String?
  videoUrl       String?
  formato        String    // texto, imagem, vídeo, combinacao
  dataPublicacao DateTime  @default(now())
  principal      Boolean   @default(false)
  dataValidade   DateTime? // Usado para Avisos (opcional)

  usuario        Usuario   @relation(fields: [usuarioId], references: [id], onDelete: Cascade)

  @@map("conteudos")
}

/// Denúncia de conteúdo escrito por outra pessoa.
///
/// ═══ POR QUE ISTO EXISTE ═══
/// O mural de oração é texto de uma pessoa lido por todas as outras. Para as
/// lojas, isso é "conteúdo gerado por usuário", e a regra exige quatro coisas:
/// filtrar, DENUNCIAR, BLOQUEAR quem abusa, e ter contato publicado. Sem elas
/// o app é reprovado — não por qualidade, por checklist.
///
/// Mas a razão de verdade não é a loja. Numa igreja, o mural é onde alguém
/// escreve o que está passando. Se aparecer ali algo agressivo ou constrangedor,
/// a pessoa atingida precisa ter o que fazer no mesmo instante — e não esperar
/// achar um líder no domingo.
model Denuncia {
  id            Int       @id @default(autoincrement())
  /// Hoje só "pedido_oracao". Existe como texto porque um dia pode haver
  /// comentário ou devocional, e migrar enum é mais caro que ler texto.
  tipo          String
  alvoId        Int
  denuncianteId Int
  motivo        String
  criadaEm      DateTime  @default(now())
  /// Nulo enquanto a liderança não tiver olhado.
  resolvidaEm   DateTime?

  denunciante Usuario @relation("DenunciasFeitas", fields: [denuncianteId], references: [id], onDelete: Cascade)

  /// Uma denúncia por pessoa por conteúdo: tocar duas vezes no botão não
  /// inflaciona a contagem nem cria fila de trabalho repetida.
  @@unique([tipo, alvoId, denuncianteId])
  /// A consulta da liderança é sempre "o que ainda não foi resolvido".
  @@index([resolvidaEm])
  @@map("denuncias")
}

/// Bloqueio de uma pessoa por outra.
///
/// Vale só em uma direção e só para quem bloqueou: some do mural DELA, e o
/// bloqueado não é avisado nem impedido de nada. Bloqueio que notifica vira
/// briga; bloqueio que pune vira ferramenta de perseguição. O que se quer aqui
/// é apenas deixar de ver.
model Bloqueio {
  bloqueadorId Int
  bloqueadoId  Int
  criadoEm     DateTime @default(now())

  bloqueador Usuario @relation("BloqueiosFeitos", fields: [bloqueadorId], references: [id], onDelete: Cascade)
  bloqueado  Usuario @relation("BloqueiosRecebidos", fields: [bloqueadoId], references: [id], onDelete: Cascade)

  @@id([bloqueadorId, bloqueadoId])
  /// O mural filtra por "quem EU bloqueei" a cada listagem.
  @@index([bloqueadorId])
  @@map("bloqueios")
}

model PedidoOracao {
  id              Int      @id @default(autoincrement())
  autorUsuarioId  Int
  descricaoPedido String
  dataEnvio       DateTime @default(now())
  visibilidade    String   @default("todos")

  autor           Usuario  @relation(fields: [autorUsuarioId], references: [id], onDelete: Cascade)

  @@map("pedidos_oracao")
}

model Curso {
  id                Int      @id @default(autoincrement())
  criadorUsuarioId  Int
  nome              String
  descricaoMaterial String?
  categoria         String   // "Homens", "Mulheres", "Casais", "Jovens", "Geral", etc.
  // Texto livre porque a duração real é uma faixa ("12 a 13 semanas"),
  // não um número exato — guardar Int obrigaria a mentir.
  duracao           String?
  publicoAlvo       String?

  criador           Usuario  @relation("CriadorCurso", fields: [criadorUsuarioId], references: [id])
  salas             SalaCurso[]
  historicoUsuarios UsuarioCurso[]
  capitulos         CapituloCurso[]

  @@map("cursos")
}

/// Ementa do curso: os temas estudados semana a semana.
/// Pertence ao curso, não à turma — toda turma do mesmo curso segue a
/// mesma sequência, então cadastrar uma vez serve para sempre.
model CapituloCurso {
  id      Int     @id @default(autoincrement())
  cursoId Int
  ordem   Int
  titulo  String
  /// Agrupamento opcional, para cursos divididos em partes
  /// ("Parte 1 – Comunicação") ou módulos.
  secao   String?

  curso   Curso   @relation(fields: [cursoId], references: [id], onDelete: Cascade)

  @@unique([cursoId, ordem])
  @@index([cursoId])
  @@map("capitulos_curso")
}

model SalaCurso {
  id         Int      @id @default(autoincrement())
  cursoId    Int
  nomeSala   String
  dataInicio DateTime?
  dataFim    DateTime?
  status     String   @default("ativa")   // "ativa", "inativa", "concluída"
  // Limite de matrículas ativas. Null = sem limite.
  capacidade Int?
  /// Quem pode participar desta turma: "Todos", "Homens" ou "Mulheres".
  ///
  /// Existe além da categoria do curso porque um curso Geral pode ter uma
  /// turma só de homens e outra só de mulheres — algo que a categoria,
  /// sendo do curso inteiro, não consegue expressar.
  publico    String   @default("Todos")
  // Quem conduz a turma. A tela de criação já prometia "você será o líder
  // desta turma", mas isso não era guardado em lugar nenhum.
  liderUsuarioId Int?

  curso      Curso    @relation(fields: [cursoId], references: [id], onDelete: Cascade)
  lider      Usuario? @relation("LiderSala", fields: [liderUsuarioId], references: [id])
  participantes UsuarioSala[]

  // A consulta da tela do curso é sempre "turmas ativas deste curso". O
  // Postgres não cria índice para chave estrangeira sozinho, então sem isto
  // ele varreria a tabela inteira — e ela só cresce a cada turma encerrada.
  @@index([cursoId, status])
  @@map("salas_curso")
}

model UsuarioCurso {
  usuarioId  Int
  cursoId    Int
  dataAdicao DateTime @default(now())
  status     String   // "em andamento" | "concluído"

  usuario    Usuario @relation(fields: [usuarioId], references: [id], onDelete: Cascade)
  curso      Curso   @relation(fields: [cursoId], references: [id], onDelete: Cascade)

  @@id([usuarioId, cursoId])
  @@map("usuarios_cursos")
}

model UsuarioSala {
  salaId        Int
  usuarioId     Int
  dataMatricula DateTime @default(now())
  status        String   @default("ativo")   // "ativo" | "cancelado_pelo_usuario" | "concluido" | "desistente"

  sala     SalaCurso @relation(fields: [salaId], references: [id], onDelete: Cascade)
  usuario  Usuario   @relation(fields: [usuarioId], references: [id], onDelete: Cascade)

  @@id([salaId, usuarioId])
  @@map("usuarios_salas")
}

model GrupoFamiliar {
  id    Int     @id @default(autoincrement())
  nome  String?
  // Foto do grupo familiar, hospedada no Cloudinary.
  imagemUrl String?
  criadorUsuarioId Int

  criador Usuario       @relation("CriadorGrupo", fields: [criadorUsuarioId], references: [id])
  membros MembroFamilia[]

  @@map("grupos_familiares")
}

model MembroFamilia {
  id              Int     @id @default(autoincrement())
  usuarioId       Int
  grupoFamiliarId Int
  parentesco      String? // "Pai", "Mãe", "Filho", "Cônjuge", "Tio", "Primo", etc.
  status          String  @default("pendente") // "pendente", "aceito", "recusado"
  convidadoPorId  Int

  usuario       Usuario       @relation("MembroDoGrupo", fields: [usuarioId], references: [id], onDelete: Cascade)
  grupoFamiliar GrupoFamiliar @relation(fields: [grupoFamiliarId], references: [id], onDelete: Cascade)
  convidadoPor  Usuario       @relation("ConvitesEnviados", fields: [convidadoPorId], references: [id])

  @@unique([usuarioId, grupoFamiliarId])
  @@map("membros_familia")
}


model Evento {
  id                 Int       @id @default(autoincrement())
  titulo             String
  descricao          String?
  local              String?
  dataInicio         DateTime
  dataFim            DateTime?
  tipo               String    @default("Outro") // "Culto", "Reunião", "Retiro", "Conferência", "Outro"
  cor                String?
  recorrencia        String    @default("nenhuma") // "nenhuma", "semanal", "mensal"
  diaSemana          Int?
  diaDoMes           Int?
  dataFimRecorrencia DateTime?
  // Destaque da tela inicial do app: no máximo um evento marcado por vez
  // (a regra é garantida no service, ao criar/atualizar).
  destaqueHome       Boolean   @default(false)
  // Capa do evento, hospedada no Cloudinary. Opcional: evento sem foto
  // continua válido e a tela cai no visual de gradiente.
  imagemUrl          String?
  criadorId          Int

  criador            Usuario   @relation("EventosCriados", fields: [criadorId], references: [id])

  @@map("eventos")
}

model TokenRevogado {
  id        Int      @id @default(autoincrement())
  token     String   @unique
  expiraEm  DateTime
  criadoEm  DateTime @default(now())

  @@map("tokens_revogados")
}

model PasswordResetToken {
  id        Int      @id @default(autoincrement())
  token     String   @unique
  usuarioId Int
  expiraEm  DateTime
  usado     Boolean  @default(false)
  criadoEm  DateTime @default(now())

  usuario   Usuario  @relation(fields: [usuarioId], references: [id], onDelete: Cascade)

  @@map("password_reset_tokens")
}

/**
 * Configuração da igreja — LINHA ÚNICA.
 *
 * `id` fixo em 1 e `@default(1)`: é um singleton. Sem essa trava, um bug de
 * upsert criaria a segunda configuração e a Home passaria a mostrar uma ou
 * outra conforme a ordem da consulta — o tipo de defeito que aparece só em
 * produção e ninguém reproduz.
 *
 * Existe para tirar do CÓDIGO o que é da igreja. A capa e o versículo do topo
 * da Home estavam escritos no fonte: trocar a frase exigia um deploy, e a
 * foto exigia commitar um arquivo em `assets/`. Nenhum pastor faz deploy.
 */
model ConfiguracaoIgreja {
  id             Int      @id @default(1)
  /// O nome da igreja NÃO mora aqui: ele está em `constants/igreja.ts`, no
  /// app. Muda uma vez na vida do projeto, quando o código é adaptado para
  /// outra congregação — configurar isso seria painel para botão que
  /// ninguém aperta. O que está aqui é o que o pastor troca de verdade.
  heroImagemUrl  String?
  versiculoHome  String?
  atualizadoEm   DateTime @updatedAt

  @@map("configuracao_igreja")
}

/// Um dia do plano de leitura anual que a pessoa marcou como lido.
///
/// ═══ POR QUE UMA LINHA POR DIA LIDO ═══
/// O contrário — uma linha por dia do ano, com um booleano — criaria 365
/// registros por pessoa no instante do cadastro, a maioria para sempre
/// `false`. Aqui a ausência da linha JÁ significa "não lido", e o banco só
/// guarda o que aconteceu.
///
/// ═══ POR QUE `dia` É TEXTO, E NÃO DATA ═══
/// "5 de agosto de 2026" aqui é um RÓTULO do plano, não um instante no tempo.
/// Guardar como `DateTime` obrigaria a escolher um fuso, e a escolha erraria:
/// meia-noite em Campo Grande é 03:00 UTC, e o mesmo registro voltaria como
/// dia 4 ou dia 5 dependendo de onde a consulta rodasse. Já aconteceu neste
/// projeto com os eventos.
///
/// Texto `YYYY-MM-DD` não tem fuso, ordena alfabeticamente na ordem certa e
/// filtra por ano com um simples prefixo.
model LeituraPlano {
  id          Int      @id @default(autoincrement())
  usuarioId   Int
  /// Dia do plano no formato `YYYY-MM-DD`. Validado no schema da rota.
  dia         String   @db.VarChar(10)
  concluidoEm DateTime @default(now())

  usuario Usuario @relation(fields: [usuarioId], references: [id], onDelete: Cascade)

  /// Marcar duas vezes o mesmo dia não pode virar dois registros: o progresso
  /// é contado por linhas, e a duplicata inflaria o número silenciosamente.
  @@unique([usuarioId, dia])
  /// A tela sempre pergunta "o que ESTA pessoa leu neste ano" — o índice
  /// atende essa consulta inteira.
  @@index([usuarioId, dia])
  @@map("leituras_plano")
}
