generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model Usuario {
  id                Int      @id @default(autoincrement())
  nomeCompleto      String
  email             String   @unique
  senha             String
  perfil            String   @default("Membro") // Membro, Líder, Pastor, Administrador
  dataNascimento    DateTime?
  exibirAniversario Boolean  @default(true)
  batizado Boolean @default(false)
  estadoCivil       String?
  fotoUrl           String?  
  sexo              String // "Masculino", "Feminino"
  profissao         String?

  conteudos         Conteudo[]
  cursosCriados      Curso[]        @relation("CriadorCurso")
  historicoCursos    UsuarioCurso[]
  participacoesSalas UsuarioSala[]
  salasLideradas     SalaCurso[]    @relation("LiderSala")
  pedidosOracao     PedidoOracao[]
  // leiturasDiarias   LeituraDiaria[]
  gruposFamiliares  MembroFamilia[] @relation("MembroDoGrupo")
  convitesEnviados  MembroFamilia[] @relation("ConvitesEnviados")
  gruposCriados     GrupoFamiliar[]  @relation("CriadorGrupo")
  eventosCriados     Evento[]  @relation("EventosCriados")
  passwordResetTokens PasswordResetToken[]

  @@map("usuarios")
}

model Conteudo {
  id             Int       @id @default(autoincrement())
  usuarioId      Int
  tipo           String    // Estudo, Devocional, Aviso, Material, Apresentacao
  titulo         String
  texto          String?   // Texto principal (pode ser rich text)
  imagemUrl      String?   // URL da imagem
  videoUrl       String?   // URL do vídeo
  formato        String    // texto, imagem, vídeo, combinacao
  dataPublicacao DateTime  @default(now())
  principal      Boolean   @default(false)
  dataValidade   DateTime? // Usado para Avisos (opcional)

  usuario        Usuario   @relation(fields: [usuarioId], references: [id], onDelete: Cascade)

  @@map("conteudos")
}

model PedidoOracao {
  id              Int      @id @default(autoincrement())
  autorUsuarioId  Int
  descricaoPedido String
  dataEnvio       DateTime @default(now())
  visibilidade    String   @default("todos")

  autor           Usuario  @relation(fields: [autorUsuarioId], references: [id], onDelete: Cascade)

  @@map("pedidos_oracao")
}

model Curso {
  id                Int      @id @default(autoincrement())
  criadorUsuarioId  Int
  nome              String
  descricaoMaterial String?
  categoria         String   // "Homens", "Mulheres", "Casais", "Jovens", "Geral", etc.
  // Texto livre porque a duração real é uma faixa ("12 a 13 semanas"),
  // não um número exato — guardar Int obrigaria a mentir.
  duracao           String?
  publicoAlvo       String?

  criador           Usuario  @relation("CriadorCurso", fields: [criadorUsuarioId], references: [id])
  salas             SalaCurso[]
  historicoUsuarios UsuarioCurso[]
  capitulos         CapituloCurso[]

  @@map("cursos")
}

/// Ementa do curso: os temas estudados semana a semana.
/// Pertence ao curso, não à turma — toda turma do mesmo curso segue a
/// mesma sequência, então cadastrar uma vez serve para sempre.
model CapituloCurso {
  id      Int     @id @default(autoincrement())
  cursoId Int
  ordem   Int
  titulo  String
  /// Agrupamento opcional, para cursos divididos em partes
  /// ("Parte 1 – Comunicação") ou módulos.
  secao   String?

  curso   Curso   @relation(fields: [cursoId], references: [id], onDelete: Cascade)

  @@unique([cursoId, ordem])
  @@index([cursoId])
  @@map("capitulos_curso")
}

model SalaCurso {
  id         Int      @id @default(autoincrement())
  cursoId    Int
  nomeSala   String
  dataInicio DateTime?
  dataFim    DateTime?
  status     String   @default("ativa")   // "ativa", "inativa", "concluída"
  // Limite de matrículas ativas. Null = sem limite.
  capacidade Int?
  // Quem conduz a turma. A tela de criação já prometia "você será o líder
  // desta turma", mas isso não era guardado em lugar nenhum.
  liderUsuarioId Int?

  curso      Curso    @relation(fields: [cursoId], references: [id], onDelete: Cascade)
  lider      Usuario? @relation("LiderSala", fields: [liderUsuarioId], references: [id])
  participantes UsuarioSala[]

  // A consulta da tela do curso é sempre "turmas ativas deste curso". O
  // Postgres não cria índice para chave estrangeira sozinho, então sem isto
  // ele varreria a tabela inteira — e ela só cresce a cada turma encerrada.
  @@index([cursoId, status])
  @@map("salas_curso")
}

model UsuarioCurso {
  usuarioId  Int
  cursoId    Int
  dataAdicao DateTime @default(now())
  status     String   // "em andamento" | "concluído"

  usuario    Usuario @relation(fields: [usuarioId], references: [id], onDelete: Cascade)
  curso      Curso   @relation(fields: [cursoId], references: [id], onDelete: Cascade)

  @@id([usuarioId, cursoId])
  @@map("usuarios_cursos")
}

model UsuarioSala {
  salaId        Int
  usuarioId     Int
  dataMatricula DateTime @default(now())
  status        String   @default("ativo")   // "ativo" | "cancelado_pelo_usuario" | "concluido" | "desistente"

  sala     SalaCurso @relation(fields: [salaId], references: [id], onDelete: Cascade)
  usuario  Usuario   @relation(fields: [usuarioId], references: [id], onDelete: Cascade)

  @@id([salaId, usuarioId])
  @@map("usuarios_salas")
}

model GrupoFamiliar {
  id    Int     @id @default(autoincrement())
  nome  String?
  // Foto do grupo familiar, hospedada no Cloudinary.
  imagemUrl String?
  criadorUsuarioId Int

  criador Usuario       @relation("CriadorGrupo", fields: [criadorUsuarioId], references: [id])
  membros MembroFamilia[]

  @@map("grupos_familiares")
}

model MembroFamilia {
  id              Int     @id @default(autoincrement())
  usuarioId       Int
  grupoFamiliarId Int
  parentesco      String? // "Pai", "Mãe", "Filho", "Cônjuge", "Tio", "Primo", etc.
  status          String  @default("pendente") // "pendente", "aceito", "recusado"
  convidadoPorId  Int

  usuario       Usuario       @relation("MembroDoGrupo", fields: [usuarioId], references: [id], onDelete: Cascade)
  grupoFamiliar GrupoFamiliar @relation(fields: [grupoFamiliarId], references: [id], onDelete: Cascade)
  convidadoPor  Usuario       @relation("ConvitesEnviados", fields: [convidadoPorId], references: [id])

  @@unique([usuarioId, grupoFamiliarId])
  @@map("membros_familia")
}


model Evento {
  id                 Int       @id @default(autoincrement())
  titulo             String
  descricao          String?
  local              String?
  dataInicio         DateTime
  dataFim            DateTime?
  tipo               String    @default("Outro") // "Culto", "Reunião", "Retiro", "Conferência", "Outro"
  cor                String?
  recorrencia        String    @default("nenhuma") // "nenhuma", "semanal", "mensal"
  diaSemana          Int?
  diaDoMes           Int?
  dataFimRecorrencia DateTime?
  // Destaque da tela inicial do app: no máximo um evento marcado por vez
  // (a regra é garantida no service, ao criar/atualizar).
  destaqueHome       Boolean   @default(false)
  // Capa do evento, hospedada no Cloudinary. Opcional: evento sem foto
  // continua válido e a tela cai no visual de gradiente.
  imagemUrl          String?
  criadorId          Int

  criador            Usuario   @relation("EventosCriados", fields: [criadorId], references: [id])

  @@map("eventos")
}

model TokenRevogado {
  id        Int      @id @default(autoincrement())
  token     String   @unique
  expiraEm  DateTime
  criadoEm  DateTime @default(now())

  @@map("tokens_revogados")
}

model PasswordResetToken {
  id        Int      @id @default(autoincrement())
  token     String   @unique
  usuarioId Int
  expiraEm  DateTime
  usado     Boolean  @default(false)
  criadoEm  DateTime @default(now())

  usuario   Usuario  @relation(fields: [usuarioId], references: [id], onDelete: Cascade)

  @@map("password_reset_tokens")
}